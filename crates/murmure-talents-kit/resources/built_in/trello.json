{
  "connector": "trello",
  "manifest": {
    "id": "trello",
    "version": "1.0.0",
    "kind": "withCode",
    "localized": {
      "fr": {
        "name": "Trello",
        "summary": "Consulte et fais avancer tes cartes Trello : tableaux, listes, commentaires."
      },
      "en": {
        "name": "Trello",
        "summary": "See and move forward your Trello cards: boards, lists, comments."
      }
    },
    "needs": [
      "organizing"
    ],
    "capabilities": [
      "read-tasks",
      "edit-tasks"
    ],
    "requires": [],
    "minimumMurmureVersion": "1.0.0",
    "platforms": [
      "macos",
      "linux"
    ],
    "author": {
      "name": "Murmure"
    },
    "license": "MIT"
  }
}
